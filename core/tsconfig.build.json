{
  "compilerOptions": {
    "target": "ES2020", 
    "module": "CommonJS",         
    "rootDir": "./src",           
    "outDir": "./dist",           
    "strict": true,               
    "esModuleInterop": true,      
    "skipLibCheck": true,        
    "forceConsistentCasingInFileNames": true,
    "composite": true,             
    "baseUrl": "./src",
    "paths": {
      "@ledger/*": ["ledger/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
